# Owl provider configuration

# Required primary Provider.
ANTHROPIC_API_KEY=

# Optional Providers. Owl registers them only when configured.
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Local Provider for privacy Mode.
OLLAMA_BASE_URL=http://localhost:11434

# Runtime defaults.
OWL_MODE=standard
OWL_LOG_LEVEL=info
OWL_MAX_CONCURRENT_PROVIDERS=3
OWL_TELEMETRY=false
